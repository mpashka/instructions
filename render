#!/usr/bin/env python3
"""Рендерер инструкций: шаблон + файл значений → готовая инструкция вне git.

    render <значения.yaml> [шаблон ...]           собрать (без шаблонов — все из файла значений)
    render --clean <значения.yaml> [шаблон ...]   затереть и удалить собранное задачей (без шаблонов — всё)

Устройство и формат файлов — README.md рядом.
"""
import argparse
import html
import os
import re
import subprocess
import sys
from pathlib import Path

import yaml

REPO = Path(__file__).resolve().parent
DEFAULT_OUT = Path("~/Projects/home/secrets-out/instructions").expanduser()
FIELDS_FILE = "fields.yaml"
TEMPLATE_FILES = ("instruction.md", "instruction.html")
DIALOGS_DIR = "dialogs"
DIALOGS_KEYS = ("site", "checked", "languages", "labels")
PLACEHOLDER = re.compile(r"\{\{\s*([a-z][a-z0-9_]*)\s*\}\}")
LABEL = re.compile(r"\{\{\s*([a-z][a-z0-9-]*):([a-z][a-z0-9-]*)\s*\}\}")
OUT_README = """# Собранные инструкции

Готовые инструкции для человека, собранные командой `{render}` из шаблонов и файлов значений.
В файлах бывают секреты открытым текстом: ИИ-агент их не читает, человек открывает сам.
Раскладка — `<проект>/<задача>/<проект>-<задача>-<шаблон>.html`: имя файла уникально, чтобы открывать его по имени в IDE.
После использования — `{render} --clean <значения.yaml>`; собрать заново — `{render} <значения.yaml>`.
"""
PROJECT_MARKERS = ("AGENTS.md", ".git")
TASKS_DIR = Path("docs/requests")
TEMPLATE_NOTE = re.compile(r"<!-- template-note:begin -->.*?<!-- template-note:end -->\n?", re.S)


class RenderError(Exception):
    pass


def view_vault(path: Path) -> str:
    # cwd — каталог vault-файла: там нет своего ansible.cfg, и пароль берётся из ~/.ansible.cfg.
    # Ключ --vault-password-file не передаётся: он добавил бы второй источник пароля.
    try:
        result = subprocess.run(["ansible-vault", "view", str(path)], cwd=path.parent,
                                stdin=subprocess.DEVNULL, capture_output=True, text=True)
    except FileNotFoundError:
        raise RenderError("нет программы ansible-vault: поставь ansible (пакет ansible-core)")
    if result.returncode != 0:
        raise RenderError(f"ansible-vault не расшифровал {path}: {result.stderr.strip()}")
    return result.stdout


class VaultReader:
    def __init__(self, view=view_vault):
        self._view = view
        self._cache = {}

    def get(self, path: Path, key: str) -> str:
        if path not in self._cache:
            if not path.is_file():
                raise RenderError(f"нет vault-файла {path}")
            self._cache[path] = yaml.safe_load(self._view(path)) or {}
        content = self._cache[path]
        if key not in content:
            raise RenderError(f"в vault-файле {path} нет ключа {key}")
        return str(content[key])


def load_yaml(path: Path) -> dict:
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise RenderError(f"нет файла {path}")
    except yaml.YAMLError as e:
        raise RenderError(f"{path} — не YAML: {e}")
    if not isinstance(data, dict):
        raise RenderError(f"{path}: ожидался словарь на верхнем уровне")
    return data


def template_dir(name: str) -> Path:
    path = REPO / name
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name) or not (path / FIELDS_FILE).is_file():
        known = ", ".join(list_templates()) or "—"
        raise RenderError(f"нет шаблона {name}; есть: {known}")
    return path


def list_templates() -> list:
    return sorted(p.parent.name for p in REPO.glob(f"*/{FIELDS_FILE}"))


def list_dialogs() -> list:
    return sorted(p.stem for p in (REPO / DIALOGS_DIR).glob("*.yaml"))


def read_dialogs(site: str) -> dict:
    """Описание диалогов сайта: универсальное имя надписи → надпись на каждом объявленном языке."""
    path = REPO / DIALOGS_DIR / f"{site}.yaml"
    if not path.is_file():
        known = ", ".join(list_dialogs()) or "—"
        raise RenderError(f"нет описания диалогов {path}; есть: {known}")
    data = load_yaml(path)
    missing = [key for key in DIALOGS_KEYS if key not in data]
    if missing:
        raise RenderError(f"{path}: нет ключей {', '.join(missing)}; ждём {', '.join(DIALOGS_KEYS)}")
    languages = data["languages"]
    if not isinstance(languages, list) or not languages:
        raise RenderError(f"{path}: languages — непустой список языков, например [en, ru]")
    data["labels"] = data["labels"] or {}
    for label, text in data["labels"].items():
        if not isinstance(text, dict):
            raise RenderError(f"{path}, надпись {label}: ожидался язык → надпись")
        for language in languages:
            if not text.get(language):
                raise RenderError(f"{path}, надпись {label}: нет языка {language}")
        extra = set(text) - set(languages)
        if extra:
            raise RenderError(f"{path}, надпись {label}: языки {', '.join(sorted(extra))} "
                              f"не объявлены в languages ({', '.join(languages)})")
    return data


def substitute_labels(text: str, name: str, file_name: str) -> str:
    """Ссылку {{<сайт>:<надпись>}} — в надпись сайта на всех его языках."""
    markup = file_name.endswith(".html")
    escape = html.escape if markup else str
    described = {site: read_dialogs(site) for site in {s for s, _ in LABEL.findall(text)}}

    def label(match):
        site, key = match.group(1), match.group(2)
        dialogs = described[site]
        if key not in dialogs["labels"]:
            known = ", ".join(sorted(dialogs["labels"])) or "—"
            raise RenderError(f"шаблон {name}, {file_name}: в описании диалогов {site} нет надписи "
                              f"{key}; есть: {known}")
        languages, texts = dialogs["languages"], dialogs["labels"][key]
        if len(languages) == 1:
            return escape(texts[languages[0]])
        if not markup:
            raise RenderError(f"шаблон {name}, {file_name}: надпись {site}:{key} — на нескольких "
                              f"языках ({', '.join(languages)}), а в Markdown нет ни переключателя, "
                              "ни рисунка экрана; такой шаг пишется в instruction.html")
        return "".join(f'<span lang="{lang}">{escape(texts[lang])}</span>' for lang in languages)

    return LABEL.sub(label, text)


def read_template(name: str):
    directory = template_dir(name)
    declared = load_yaml(directory / FIELDS_FILE).get("fields") or {}
    files = {f: (directory / f).read_text(encoding="utf-8")
             for f in TEMPLATE_FILES if (directory / f).is_file()}
    if not files:
        raise RenderError(f"в шаблоне {name} нет ни одного из {', '.join(TEMPLATE_FILES)}")
    files = {f: substitute_labels(text, name, f) for f, text in files.items()}
    used = {m for text in files.values() for m in PLACEHOLDER.findall(text)}
    if used - set(declared):
        raise RenderError(f"шаблон {name} использует поля, не объявленные в {FIELDS_FILE}: "
                          f"{', '.join(sorted(used - set(declared)))}")
    if set(declared) - used:
        raise RenderError(f"шаблон {name} объявляет поля, которых нет в тексте: "
                          f"{', '.join(sorted(set(declared) - used))}")
    return declared, files


def resolve_values(name: str, declared: dict, raw: dict, values_file: Path, vault: VaultReader):
    raw = raw or {}
    unknown = set(raw) - set(declared)
    if unknown:
        raise RenderError(f"{values_file}, шаблон {name}: неизвестные поля {', '.join(sorted(unknown))}; "
                          f"шаблон ждёт: {', '.join(sorted(declared)) or '—'}")
    missing = [f for f in declared if raw.get(f) in (None, "")]
    if missing:
        raise RenderError(f"{values_file}, шаблон {name}: не заполнены поля {', '.join(missing)}")
    values, from_vault = {}, []
    for field, value in raw.items():
        if isinstance(value, dict):
            if set(value) != {"vault", "key"}:
                raise RenderError(f"{values_file}, поле {field}: ссылка на секрет — "
                                  "{vault: <файл>, key: <ключ>}")
            path = Path(os.path.expanduser(str(value["vault"])))
            if not path.is_absolute():
                path = values_file.parent / path
            values[field] = vault.get(path.resolve(), str(value["key"]))
            from_vault.append(field)
        elif isinstance(value, (str, int, float)):
            values[field] = str(value)
        else:
            raise RenderError(f"{values_file}, поле {field}: значение — строка или ссылка на vault")
    return values, from_vault


def substitute(text: str, values: dict, escape) -> str:
    text = TEMPLATE_NOTE.sub("", text)
    return PLACEHOLDER.sub(lambda m: escape(values[m.group(1)]), text)


def write_private(path: Path, text: str):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        os.fchmod(f.fileno(), 0o600)
        f.write(text)


def make_private_dir(path: Path):
    path.mkdir(parents=True, exist_ok=True)
    path.chmod(0o700)


def wipe_file(path: Path):
    size = path.stat().st_size
    with open(path, "r+b") as f:
        f.write(b"\0" * size)
        f.flush()
        os.fsync(f.fileno())
    path.unlink()


def wipe_dir(path: Path):
    for child in path.iterdir():
        if child.is_dir() and not child.is_symlink():
            wipe_dir(child)
        elif child.is_file() and not child.is_symlink():
            wipe_file(child)
        else:
            child.unlink()
    path.rmdir()


class TaskLocation:
    """Где лежит собранное задачей: каталог <проект>/<задача> и префикс имени файла <проект>-<задача>.

    Проект — ближайший каталог над файлом значений с AGENTS.md или .git; задача — путь от проекта до
    каталога файла значений без docs/requests.
    """

    def __init__(self, values_file: Path):
        directory = values_file.resolve().parent
        project = next((d for d in (directory, *directory.parents)
                        if any((d / m).exists() for m in PROJECT_MARKERS)), None)
        if project is None:
            raise RenderError(f"{values_file}: файл значений лежит вне проекта — "
                              f"выше нет ни {' ни '.join(PROJECT_MARKERS)}; положи его в каталог задачи")
        task = directory.relative_to(project)
        if task.is_relative_to(TASKS_DIR):
            task = task.relative_to(TASKS_DIR)
        if task == Path("."):
            raise RenderError(f"{values_file}: файл значений лежит в корне проекта {project}; "
                              "положи его в каталог задачи")
        self.directory = Path(project.name) / task
        self.prefix = f"{project.name}-{task.name}"

    def file_name(self, template: str, template_file: str) -> str:
        return f"{self.prefix}-{template}{Path(template_file).suffix}"


def render(values_file: Path, names: list, out_root: Path, vault: VaultReader) -> list:
    values_file = values_file.resolve()
    location = TaskLocation(values_file)
    sections = load_yaml(values_file)
    names = names or list(sections)
    if not names:
        raise RenderError(f"{values_file}: пусто — ни одного шаблона")
    prepared = []
    for name in names:
        if name not in sections:
            raise RenderError(f"{values_file}: нет раздела {name}; есть: {', '.join(sections) or '—'}")
        declared, files = read_template(name)
        values, from_vault = resolve_values(name, declared, sections[name], values_file, vault)
        prepared.append((name, files, values, from_vault))
    make_private_dir(out_root)
    write_private(out_root / "README.md", OUT_README.format(render=REPO / "render"))
    report = []
    target = out_root
    for part in location.directory.parts:
        target = target / part
        make_private_dir(target)
    for name, files, values, from_vault in prepared:
        written = []
        for file_name, text in files.items():
            path = target / location.file_name(name, file_name)
            escape = html.escape if file_name.endswith(".html") else str
            write_private(path, substitute(text, values, escape))
            written.append(path)
        report.append((name, written, sorted(values), sorted(from_vault)))
    return report


def clean(values_file: Path, names: list, out_root: Path) -> list:
    location = TaskLocation(values_file)
    target = out_root / location.directory
    if not target.is_dir():
        return []
    if not names:
        wipe_dir(target)
        return [target]
    removed = []
    for name in names:
        for file_name in TEMPLATE_FILES:
            path = target / location.file_name(name, file_name)
            if path.is_file():
                wipe_file(path)
                removed.append(path)
    return removed


def main(argv=None, vault=None) -> int:
    parser = argparse.ArgumentParser(prog="render", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--clean", action="store_true", help="затереть и удалить собранные инструкции")
    parser.add_argument("--out", type=Path, default=Path(os.environ.get("INSTRUCTIONS_OUT", DEFAULT_OUT)),
                        help=f"куда собирать (по умолчанию {DEFAULT_OUT}, или $INSTRUCTIONS_OUT)")
    parser.add_argument("args", nargs="*", help="файл значений и шаблоны")
    options = parser.parse_args(argv)
    out_root = options.out.expanduser()
    try:
        if not options.args:
            parser.error("нужен файл значений")
        values_file, *names = options.args
        if options.clean:
            removed = clean(Path(values_file), names, out_root)
            print("удалено: " + (", ".join(map(str, removed)) if removed else "нечего"))
            return 0
        report = render(Path(values_file), names, out_root, vault or VaultReader())
        for name, written, fields, from_vault in report:
            print(f"{name}:")
            for path in written:
                print(f"  {path}")
            print(f"  поля: {', '.join(f + (' (vault)' if f in from_vault else '') for f in fields) or '—'}")
        out_flag = "" if out_root == DEFAULT_OUT else f" --out {out_root}"
        print(f"после использования: {REPO / 'render'}{out_flag} --clean {Path(values_file).resolve()}")
        return 0
    except RenderError as e:
        print(f"render: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
